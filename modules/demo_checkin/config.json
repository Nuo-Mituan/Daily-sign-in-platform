{
  "name": "演示签到",
  "description": "单账号示例模块：读取账号、密码、区服等参数，模拟完成每日签到并输出过程日志；支持随机执行时间与模拟失败。不会访问任何真实接口。",
  "author": "Daily Check-in Platform",
  "version": "1.1.0",
  "icon": "🎯",
  "default_start_time": "09:00",
  "default_end_time": "11:00",
  "default_repeat_cycle": "daily",
  "multi_account": false,
  "params": [
    {
      "key": "account",
      "label": "账号",
      "type": "text",
      "required": true,
      "account_label": true,
      "placeholder": "任意演示账号，例如 demo@example.com",
      "help": "演示模块不会发送任何网络请求，可随意填写。"
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password",
      "required": true,
      "sensitive": true,
      "placeholder": "请输入演示密码"
    },
    {
      "key": "server",
      "label": "服务器",
      "type": "select",
      "required": true,
      "default": "cn",
      "options": [
        { "label": "国服", "value": "cn" },
        { "label": "国际服", "value": "global" }
      ]
    },
    {
      "key": "mode",
      "label": "执行模式",
      "type": "select",
      "default": "success",
      "options": [
        { "label": "正常签到（成功）", "value": "success" },
        { "label": "模拟失败（测试日志与统计）", "value": "failure" }
      ],
      "help": "选择“模拟失败”可以看到失败状态、日志与统计的变化。"
    },
    {
      "key": "retries",
      "label": "重试次数",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 5,
      "step": 1,
      "placeholder": "1"
    },
    {
      "key": "verbose",
      "label": "详细日志",
      "type": "switch",
      "default": true,
      "help": "开启后输出每个模拟步骤。"
    }
  ]
}
