# 上线前请阅读 docs/PRODUCTION_SECURITY.md 中的生产安全检查清单。
# 复制为 .env 后按需修改；docker compose 会自动读取本文件进行变量替换。
# 注意：默认密码仅用于首次启动，登录后请立即在网页端修改。

APP_PORT=5000
# 使用 Nginx / Caddy 反向代理时建议改为 127.0.0.1，避免直接暴露到公网。
APP_BIND=0.0.0.0
TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai

ADMIN_USER=admin
# ADMIN_PASS= (留空则自动生成随机密码)

# 可选。留空时会自动生成并持久化到 ./data/.secret_key。
# 如果手动设置，请务必长期保存同一个值；更换后已保存的模块参数将无法解密。
# 推荐生成方式：openssl rand -hex 32
# SECRET_KEY=please-change-me-to-a-long-random-string

# 单个账号单次执行的最长秒数（多账号模式下每个账号分别计时）
MODULE_TIMEOUT=300

# 多账号串行执行时，账号之间的随机等待区间（秒）。默认 2-5 分钟。
ACCOUNT_INTERVAL_MIN_SECONDS=120
ACCOUNT_INTERVAL_MAX_SECONDS=300

# 随机时间至少提前多少秒生成，避免生成后立刻执行
SCHEDULE_MIN_LEAD_SECONDS=5

# 统一环形日志保留天数（1-365；也可在网页「用户设置 → 日志设置」修改）
LOG_RETENTION_DAYS=31

# 环形日志容量约束（条数 / 字节；每日查询或写入超限时 FIFO 淘汰最旧）
RING_LOG_MAX_ROWS=200000
RING_LOG_MAX_BYTES=134217728
RING_SYSTEM_MAX_ROWS=50000
RING_SYSTEM_MAX_BYTES=33554432
RING_MODULE_MAX_ROWS=20000
RING_MODULE_MAX_BYTES=16777216
RING_PUSH_MAX_ROWS=50000
RING_PUSH_MAX_BYTES=33554432
RING_TRIM_BATCH_SIZE=1000
RING_QUEUE_MAX=10000
RING_BUSY_TIMEOUT_SECONDS=15
RING_WRITE_RETRIES=6
RING_TRIM_MAX_LOOPS=10000
SSE_KEEPALIVE_SECONDS=15
SSE_QUEUE_MAX=2000

# 单次执行捕获的最大输出字符数
LOG_MAX_CHARS=512000

# 模块 ZIP 包上传大小限制（MB）
UPLOAD_MAX_MB=10

# 同源部署时留空即可。若前后端分离，填写逗号分隔的允许来源。
CORS_ORIGINS=

# Docker 容器运行用户（入口脚本会 chown data/logs 后降权）
PUID=10001
PGID=10001

# 内网 HTTP 默认 false；将来加 HTTPS 反代时改为 true
COOKIE_SECURE=false

# Cookie 会话的轻量 CSRF 头校验，默认开启
CSRF_ENABLED=true

# 统一推送批次
PUSH_SKIP_NOTICE=true
PUSH_AFTER_FLUSH_MODE=single
PUSH_RETRY_ATTEMPTS=3
PUSH_RETRY_BASE_SECONDS=1.0
PUSH_DRIVER_MAX_VERSIONS=5

# 推送 HTTP 客户端与响应截断
PUSH_HTTP_TIMEOUT_SECONDS=10
PUSH_CONNECT_TIMEOUT_SECONDS=5
PUSH_REQUEST_RETRY_SECONDS=0.8
PUSH_RESPONSE_MAX_CHARS=4000
